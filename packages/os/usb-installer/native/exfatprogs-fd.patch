--- a/lib/libexfat.c
+++ b/lib/libexfat.c
@@ -147 +147,15 @@
-	fd = open(ui->dev_name, ui->writeable ? O_RDWR|O_EXCL : O_RDONLY);
+	/* elizaOS: the broker already holds the whole-device exclusive claim.
+	 * Duplicate its retained partition FD; reopening even /proc/self/fd/4
+	 * with O_EXCL would take a second, incompatible block-device claim. */
+	if (strcmp(ui->dev_name, "/proc/self/fd/4") != 0 ||
+	    fstat(4, &st) != 0 || !S_ISBLK(st.st_mode)) {
+		exfat_err("elizaOS requires an inherited block-device FD 4\n");
+		return -1;
+	}
+	ret = fcntl(4, F_GETFL);
+	if (ret < 0 || (ret & O_ACCMODE) == O_WRONLY ||
+	    (ui->writeable && (ret & O_ACCMODE) != O_RDWR)) {
+		exfat_err("elizaOS inherited descriptor has invalid access mode\n");
+		return -1;
+	}
+	fd = fcntl(4, F_DUPFD_CLOEXEC, 5);
--- a/mkfs/mkfs.c
+++ b/mkfs/mkfs.c
@@ -619 +619 @@
-int main(int argc, char *argv[])
+static int exfat_main(int argc, char *argv[])
@@ -765,0 +766,11 @@
+
+/* No caller-supplied pathname or option reaches the formatter/verifier. */
+int main(int argc, char * const argv[])
+{
+	char *fixed[] = { "elizaos-mkfs-exfat-fd", "-L", "ELIZAOS-USB", "/proc/self/fd/4", NULL };
+	if (argc != 1 || argv == NULL || argv[0] == NULL) {
+		fputs("elizaOS exFAT FD helper takes no arguments\n", stderr);
+		return 2;
+	}
+	return exfat_main((int)(sizeof(fixed) / sizeof(fixed[0])) - 1, fixed);
+}
