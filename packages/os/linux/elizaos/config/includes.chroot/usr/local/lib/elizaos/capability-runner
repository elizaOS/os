#!/bin/sh
set -eu

self=/usr/local/lib/elizaos/capability-runner

usage() {
    echo "usage: capability-runner <root-status|service|package|network|power|exec> [args...]" >&2
    exit 64
}

need_admin_mode() {
    [ "$(cat /etc/elizaos/admin-mode 2>/dev/null || printf disabled)" = enabled ] || {
        echo "elizaOS owner admin mode is disabled." >&2
        exit 77
    }
}

need_root() {
    if [ "$(id -u)" -ne 0 ]; then
        exec sudo -n "${self}" "$@"
    fi
}

audit() {
    logger -p authpriv.notice -t elizaos-capability \
        "caller_uid=${SUDO_UID:-$(id -u)} caller_user=${SUDO_USER:-$(id -un)} action=$*" 2>/dev/null || true
}

valid_unit() {
    case "$1" in ""|-*|*[!A-Za-z0-9@_.:-]*) return 1 ;; *) return 0 ;; esac
}

valid_package() {
    case "$1" in ""|-*|*[!A-Za-z0-9.+:-]*) return 1 ;; *) return 0 ;; esac
}

[ "$#" -ge 1 ] || usage
command_name="$1"
shift

case "${command_name}" in
    root-status)
        [ "$#" -eq 0 ] || usage
        need_root "${command_name}"
        printf 'root=yes\nbase=debian\nuid=%s\n' "$(id -u)"
        ;;
    service)
        [ "$#" -eq 2 ] || usage
        action="$1"; unit="$2"
        case "${action}" in start|stop|restart|enable|disable) ;; *) usage ;; esac
        valid_unit "${unit}" || usage
        need_admin_mode
        need_root "${command_name}" "${action}" "${unit}"
        audit "service ${action} ${unit}"
        exec systemctl "${action}" -- "${unit}"
        ;;
    package)
        [ "$#" -ge 1 ] || usage
        action="$1"; shift
        case "${action}" in
            update) [ "$#" -eq 0 ] || usage ;;
            install|remove)
                [ "$#" -ge 1 ] || usage
                for package_name in "$@"; do valid_package "${package_name}" || usage; done
                ;;
            *) usage ;;
        esac
        need_admin_mode
        need_root "${command_name}" "${action}" "$@"
        audit "package ${action} $*"
        export DEBIAN_FRONTEND=noninteractive
        case "${action}" in
            update) exec apt-get update ;;
            install) exec apt-get -y --no-install-recommends install "$@" ;;
            remove) exec apt-get -y remove "$@" ;;
        esac
        ;;
    network)
        [ "$#" -eq 2 ] || usage
        action="$1"; connection="$2"
        case "${action}" in up|down) ;; *) usage ;; esac
        case "${connection}" in ""|*'
'*|*''*) usage ;; esac
        need_admin_mode
        need_root "${command_name}" "${action}" "${connection}"
        audit "network ${action} ${connection}"
        exec nmcli connection "${action}" id "${connection}"
        ;;
    power)
        [ "$#" -eq 1 ] || usage
        action="$1"
        case "${action}" in reboot|poweroff) ;; *) usage ;; esac
        need_admin_mode
        need_root "${command_name}" "${action}"
        audit "power ${action}"
        exec systemctl "${action}"
        ;;
    exec)
        [ "$#" -ge 2 ] || usage
        [ "$1" = -- ] || usage
        shift
        executable="$1"
        case "${executable}" in /*) ;; *) usage ;; esac
        [ -x "${executable}" ] || {
            echo "elizaOS root executable is unavailable: ${executable}" >&2
            exit 69
        }
        need_admin_mode
        need_root "${command_name}" -- "$@"
        audit "exec executable=${executable} argc=$#"
        exec env -i HOME=/root USER=root LOGNAME=root \
            PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
            "$@"
        ;;
    *) usage ;;
esac
