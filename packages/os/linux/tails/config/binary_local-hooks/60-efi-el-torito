#!/bin/sh
# Build the FAT image required by UEFI optical boot. Keep Tails' normal signed
# GRUB loader in binary/EFI/BOOT for USB/disk boot, but put Debian's signed CD
# loader behind shim in the El Torito image. The CD loader embeds the memdisk
# bootstrap that discovers the ISO9660 root and switches to /boot/grub.

set -e

. config/bootstrap
. config/variables

if [ "${LB_ARCHITECTURE}" != "amd64" ]; then
    exit 0
fi

EFI_SOURCE="binary/EFI/BOOT"
SHIM_SOURCE="${EFI_SOURCE}/BOOTX64.EFI"
DISK_GRUB_SOURCE="${EFI_SOURCE}/GRUBX64.EFI"
CD_GRUB_SOURCE="chroot/usr/lib/grub/x86_64-efi-signed/gcdx64.efi.signed"
EFI_IMAGE="binary/boot/grub/efi.img"
GRUB_REDIRECT="binary/boot/grub/grub.cfg"
WORK_DIR="$(mktemp -d tmp/elizaos-efi-el-torito.XXXXXX)"

cleanup() {
    rm -rf "${WORK_DIR}"
}
trap cleanup EXIT HUP INT TERM

for required_loader in "${SHIM_SOURCE}" "${DISK_GRUB_SOURCE}" "${CD_GRUB_SOURCE}"; do
    if [ ! -s "${required_loader}" ]; then
        echo "E: required UEFI loader is missing: ${required_loader}" >&2
        exit 1
    fi
done

mkdir -p "$(dirname "${EFI_IMAGE}")"
cat >"${GRUB_REDIRECT}" <<'EOF'
search --file --set=root /live/vmlinuz
configfile ($root)/EFI/debian/grub.cfg
EOF
touch -d "@${SOURCE_DATE_EPOCH}" "${GRUB_REDIRECT}"

payload_size=$(stat -c %s "${SHIM_SOURCE}")
payload_size=$((payload_size + $(stat -c %s "${CD_GRUB_SOURCE}")))

# Three FAT directories plus 24 KiB of allocator headroom match Debian's
# live-build sizing contract. Round to 32 KiB for deterministic FAT layout.
payload_size=$((payload_size + 4096 * 3))
blocks=$(((payload_size / 1024 + 55) / 32 * 32))
if [ "${blocks}" -ge 32768 ]; then
    echo "E: UEFI El Torito image would exceed the 32 MiB firmware limit" >&2
    exit 1
fi

rm -f "${EFI_IMAGE}"
volume_id="$(printf '%08x' $((SOURCE_DATE_EPOCH % 4294967296)))"
mkfs.msdos -C "${EFI_IMAGE}" "${blocks}" -i "${volume_id}" >/dev/null
mmd -i "${EFI_IMAGE}" ::EFI
mmd -i "${EFI_IMAGE}" ::EFI/BOOT
mcopy -m -o -i "${EFI_IMAGE}" "${SHIM_SOURCE}" ::EFI/BOOT/BOOTX64.EFI
mcopy -m -o -i "${EFI_IMAGE}" "${CD_GRUB_SOURCE}" ::EFI/BOOT/GRUBX64.EFI

for required_path in ::EFI/BOOT/BOOTX64.EFI ::EFI/BOOT/GRUBX64.EFI; do
    if ! mdir -i "${EFI_IMAGE}" "${required_path}" >/dev/null; then
        echo "E: UEFI El Torito image is missing ${required_path}" >&2
        exit 1
    fi
done

echo "I: created ${EFI_IMAGE} with signed shim and signed CD GRUB (${blocks} KiB)"
